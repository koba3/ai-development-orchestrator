# Bootstrap。アプリ起動前に必要で、UI からは変更しない
PORT=3000
LOG_LEVEL=info
# openssl rand -base64 32 などで 16 文字以上を入れる
ENCRYPTION_KEY=
ADMIN_TOKEN=
CONFIG_STORE_PATH=.data/runtime-config.json

# 初回起動時だけ、この JSON があれば Runtime Configuration へ取り込む
# 2 回目以降の Slack 接続と Project は http://127.0.0.1:3000/admin で変更する
SLACK_CONNECTIONS_CONFIG=config/slack-connections.json
# 取り込み元の JSON が環境変数名だけを指しているとき、その名前をここに置く
SLACK_WORKSPACE_A_BOT_TOKEN=
SLACK_WORKSPACE_A_APP_TOKEN=
SLACK_WORKSPACE_A_SIGNING_SECRET=
SLACK_WORKSPACE_B_BOT_TOKEN=
SLACK_WORKSPACE_B_APP_TOKEN=
SLACK_WORKSPACE_B_SIGNING_SECRET=

# Notion integration。Task DB をこの Integration に共有する
NOTION_TOKEN=
NOTION_TASK_DATABASE_ID=
# npm run notion:setup のときだけ必要。データベースを置く親ページ ID
NOTION_PARENT_PAGE_ID=

# Local Coding Agent。コード変更は Agent Runtime 配下の CLI が行う
# Project の agentLinks があるときは、そちらが CODING_AGENT より優先される
# コマンドの実体は config/agents.example.json。ここが空ならその既定値を使う
CODING_AGENT=claude
CLAUDE_COMMAND=
CODEX_COMMAND=
CURSOR_COMMAND=
# 例: --model sonnet
CLAUDE_EXTRA_ARGS=
# ミリ秒。既定は 30 分
CLAUDE_TIMEOUT_MS=1800000
WORKTREE_ROOT=/Users/koba/worktrees
SCHEDULER_INTERVAL_MS=5000
# false にすると Slack 受付だけ動き、READY タスクは拾わない
SCHEDULER_ENABLED=true

# Optional Planner LLM。未設定なら API キーは不要で、プロセスは起動する
# 依頼の分解に使うときだけ、どちらか一方を有効にする
# PLANNER_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# PLANNER_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# 依頼文がローカルパスを含まないときのリポジトリ
# 例: /Users/me/projects/questoon
DEFAULT_REPOSITORY=
# この値未満の confidence は NEEDS_HUMAN にする
PLAN_CONFIDENCE_THRESHOLD=0.6

# Phase 2: ホスト上の Claude Code CLI。API ではコードを生成しない
# 初回起動時だけ config/projects.json を Runtime Configuration へ取り込む
PROJECTS_CONFIG=config/projects.json
AGENTS_CONFIG=config/agents.json
# npm run simulate がルーティングに使う Slack workspace と channel
SIMULATE_WORKSPACE_ID=
SIMULATE_CHANNEL_ID=
