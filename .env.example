# HTTP health check
PORT=3000
LOG_LEVEL=info

# Slack app (Socket Mode)
# Bot Token Scopes: chat:write, channels:history, groups:history, im:history, mpim:history
# Event subscriptions: message.channels, message.groups, message.im
# Socket Mode を有効にし、App-Level Token に connections:write を付ける
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# 空なら、ボットが参加している会話の人間メッセージをすべて依頼として扱う
# 制限するときは C0123,C0456 のようにカンマ区切り
SLACK_CHANNEL_IDS=

# Notion integration。Task DB をこの Integration に共有する
NOTION_TOKEN=
NOTION_TASK_DATABASE_ID=
# npm run notion:setup のときだけ必要。データベースを置く親ページ ID
NOTION_PARENT_PAGE_ID=

# Local Coding Agent。コード変更はローカルの CLI が行う
CODING_AGENT=claude
CLAUDE_COMMAND=claude
# 例: --model sonnet
CLAUDE_EXTRA_ARGS=
# ミリ秒。既定は 30 分
CLAUDE_TIMEOUT_MS=1800000
WORKTREE_ROOT=/Users/koba/worktrees
SCHEDULER_INTERVAL_MS=5000
# false にすると Slack 受付だけ動き、READY タスクは拾わない
SCHEDULER_ENABLED=true

# Optional Planner LLM。未設定なら API キーは不要で、プロセスは起動する
# 依頼の分解に使うときだけ、どちらか一方を有効にする
# PLANNER_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# PLANNER_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# 依頼文がローカルパスを含まないときのリポジトリ
# 例: /Users/me/projects/questoon
DEFAULT_REPOSITORY=
# この値未満の confidence は NEEDS_HUMAN にする
PLAN_CONFIDENCE_THRESHOLD=0.6

# Phase 2: ホスト上の Claude Code CLI。API ではコードを生成しない
# config/projects.example.json をコピーして workspace / channel / project を書く
PROJECTS_CONFIG=config/projects.json
# npm run simulate がルーティングに使う Slack workspace と channel
SIMULATE_WORKSPACE_ID=
SIMULATE_CHANNEL_ID=
