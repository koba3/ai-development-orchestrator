{
  "name": "ai-development-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "notion:setup": "tsx src/notion/setup-database.ts",
    "simulate": "tsx src/cli/simulate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@notionhq/client": "^4.0.1",
    "@slack/bolt": "^4.4.0",
    "@slack/web-api": "^7.9.3",
    "dotenv": "^17.2.2",
    "openai": "^5.20.0",
    "pino": "^9.9.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
